# World Cup Email Agent — environment variables
#
# Copy to .env (or export in your shell / cron job) before enabling --send.

# Recipient (defaults to the repo owner's QQ address)
WC_EMAIL_TO=3461630168@qq.com

# Display timezone for kickoff times in the email
WC_TIMEZONE=Asia/Shanghai

# How many days ahead to include in the default "window" digest
WC_LOOKAHEAD_DAYS=3

# Set to 0 only when you are ready to send real email
WC_DRY_RUN=1

# SMTP — QQ Mail example (use an authorization code, not your login password)
# Generate at: QQ Mail → Settings → Account → POP3/IMAP/SMTP → authorization code
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USERNAME=3461630168@qq.com
SMTP_PASSWORD=your_qq_authorization_code
WC_EMAIL_FROM=3461630168@qq.com
WC_SENDER_NAME=World Cup Schedule Agent

# Optional alternate schedule feed
# WC_SCHEDULE_URL=https://wheniskickoff.com/data/v1/matches.json

# Dry-run output directory
WC_OUTPUT_DIR=out
