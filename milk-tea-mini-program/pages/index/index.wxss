.home-page {
  padding-bottom: 128rpx;
}

.hero {
  background: linear-gradient(135deg, #7a4a2a, #c9894b);
  color: #ffffff;
}

.eyebrow {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.82;
  text-transform: uppercase;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
  margin-top: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  line-height: 1.5;
  margin-top: 18rpx;
  opacity: 0.88;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.smart-input {
  background: #fff7ec;
  border: 2rpx solid #ecd1b5;
  border-radius: 20rpx;
  box-sizing: border-box;
  height: 88rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
}

.preview {
  margin-top: 18rpx;
}

.preset-row {
  align-items: center;
  border-bottom: 2rpx solid #f4e5d5;
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
}

.preset-row:last-child {
  border-bottom: 0;
}

.preset-name,
.product-name {
  font-size: 31rpx;
  font-weight: 800;
}

.preset-action {
  background: #fff0df;
  border-radius: 999rpx;
  color: #7a4a2a;
  font-size: 24rpx;
  font-weight: 800;
  padding: 12rpx 24rpx;
}

.menu-title {
  margin: 36rpx 0 18rpx;
}

.product-main {
  align-items: flex-start;
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 22rpx 0;
}

.tag {
  background: #f7e8d7;
  border-radius: 999rpx;
  color: #7a4a2a;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.cart-fab {
  bottom: 32rpx;
  left: 32rpx;
  position: fixed;
  right: 32rpx;
}
