page {
  background: #fff7ec;
  color: #382216;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(84, 48, 25, 0.08);
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.primary-button {
  background: #7a4a2a;
  border-radius: 999rpx;
  color: #ffffff;
  font-weight: 700;
}

.secondary-button {
  background: #f4dfc6;
  border-radius: 999rpx;
  color: #6b3d1f;
  font-weight: 700;
}

.muted {
  color: #947760;
  font-size: 26rpx;
}

.price {
  color: #b76323;
  font-weight: 800;
}
